rules_version = '2';
// Snooker Century — Firestore security rules.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is a logged-in user whose UID is listed in the "admins" collection.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Tournaments, fixtures, results: anyone can view, only admins can change.
    match /tournaments/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow delete: if isAdmin();
    }

    // Player names and IDs: anyone can view, only admins can change.
    match /players/{id} {
      allow read: if true;
      allow write: if isAdmin() && id.matches('^[0-9]{5}$');
    }

    // Phone numbers: admins only.
    match /phones/{id} {
      allow read, write: if isAdmin();
    }

    // Admin list: each admin can check their own entry; changes only in the Firebase console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
